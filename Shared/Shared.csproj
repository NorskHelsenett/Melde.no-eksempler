<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="HelseID.Library.ClientCredentials" Version="1.1.3" />
		<PackageReference Include="NSwag.ApiDescription.Client" Version="14.7.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Remember to set <ClassName> - https://github.com/dotnet/aspnetcore/issues/21656 -->
	<ItemGroup>
		<OpenApiReference Include="OpenAPI\swagger.json" CodeGenerator="NSwagCSharp" Namespace="MeldeV2">
			<!--<SourceUri>https://api.qa.melde.no/swagger/index.html?url=/swagger/External/v1/swagger.json</SourceUri>-->
			<ClassName>{controller}Client</ClassName>
			<Options>/useBaseUrl:false /GenerateClientInterfaces:false /GenerateExceptionClasses:false /AdditionalNamespaceUsages:OpenAPI /JsonLibrary:SystemTextJson</Options>
		</OpenApiReference>
	</ItemGroup>
</Project>
